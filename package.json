{
  "name": "@deeplinknow/react-native",
  "version": "1.4.0",
  "description": "DeepLinkNow React Native and Expo SDK: deferred deep links, Universal Links and App Links. Returns the link a user tapped before installing. No attribution, no advertising IDs.",
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "deep linking",
    "deep-link",
    "deferred deep linking",
    "deferred-deep-link",
    "universal-links",
    "app-links",
    "expo-router",
    "firebase-dynamic-links",
    "dynamic-links",
    "install-referrer"
  ],
  "homepage": "https://deeplinknow.com/docs/react-native",
  "bugs": {
    "url": "https://github.com/deeplinknow/dln-react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeplinknow/dln-react-native.git"
  },
  "license": "MIT",
  "author": "DeepLinkNow <2121331+jvgeee@users.noreply.github.com> (https://deeplinknow.com)",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./expo-router": {
      "types": "./build/expo-router.d.ts",
      "default": "./build/expo-router.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "main": "./build/index.js",
  "source": "./src/index.ts",
  "types": "./build/index.d.ts",
  "files": [
    "src",
    "build",
    "android",
    "ios",
    "cpp",
    "plugin/build",
    "app.plugin.js",
    "expo-router/package.json",
    "*.podspec",
    "expo-module.config.json",
    "react-native.config.js",
    "CHANGELOG.md",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "expo-module build",
    "build-plugin": "tsc --project plugin/tsconfig.json",
    "clean": "expo-module clean",
    "expo-module": "expo-module",
    "format": "ultracite fix",
    "lint": "ultracite check --error-on-warnings",
    "open:android": "open -a \"Android Studio\" example/android",
    "open:ios": "xed example/ios",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly && ultracite check --error-on-warnings",
    "release": "pnpm clean && pnpm format && pnpm prepare && git add -A && git commit -m 'chore: prepare release' --no-verify && git push && pnpm release-it",
    "release:public": "bash scripts/release-public.sh",
    "release-it": "release-it",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/dln-example",
      "<rootDir>/build/",
      "<rootDir>/plugin/build/"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin/src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "\\.d\\.ts$",
      "/node_modules/"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@expo/config-plugins": "~10.1.2",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.0.0",
    "@types/react": "~19.1.0",
    "del-cli": "^5.1.0",
    "expo": "^54.0.18",
    "expo-module-scripts": "^5.0.7",
    "expo-modules-core": "~3.0.21",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "react": "*",
    "react-native": "0.81.5",
    "react-test-renderer": "19.2.0",
    "release-it": "^18.1.2",
    "typescript": "^5.9.2",
    "ultracite": "7.12.2"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "codegenConfig": {
    "name": "NativeDeepLinkNowSpec",
    "type": "modules",
    "jsSrcsDir": "./src/specs",
    "android": {
      "javaPackageName": "com.deeplinknow.reactnative"
    }
  },
  "deeplinknow": {
    "iosSdkVersion": "1.4.0",
    "androidSdkVersion": "1.4.0"
  },
  "expo": {
    "plugin": {
      "main": "./plugin/build/index.js",
      "types": "./plugin/build/index.d.ts"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@deeplinknow/react-native"
        ]
      }
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  }
}
